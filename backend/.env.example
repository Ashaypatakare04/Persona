# Persona Backend Environment Variables

PROJECT_NAME="Persona - Personal AI Representative"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to persistent local SQLite)
DATABASE_URL="sqlite+aiosqlite:///./data/persona.db"

# LLM Provider: "mock" (default, zero keys required), "gemini", or "openai"
DEFAULT_LLM_PROVIDER="mock"

# Optional External API Keys (configured via Settings UI or .env)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
